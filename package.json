{
  "name": "hexagone-connect",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "vitest --watch",
    "build": "pnpm -r --if-present run build",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'tests/architecture/**' --exclude 'tests/contracts/**' --exclude 'tests/integration/**' --exclude 'tests/e2e/**'",
    "test:contracts": "vitest run tests/contracts",
    "test:architecture": "vitest run tests/architecture",
    "test:integration": "tsx scripts/run-test-stage.ts integration",
    "test:e2e": "tsx scripts/run-test-stage.ts e2e",
    "test:a11y": "tsx scripts/run-test-stage.ts a11y",
    "test:ai": "tsx scripts/run-test-stage.ts ai",
    "lint": "eslint .",
    "format": "prettier --write AGENTS.md CLAUDE.md .github .prettierrc.json docs/methodology policies scripts tests package.json pnpm-workspace.yaml tsconfig.json vitest.config.ts eslint.config.mjs apps/**/package.json services/**/package.json packages/**/package.json",
    "format:check": "prettier --check AGENTS.md CLAUDE.md .github .prettierrc.json docs/methodology policies scripts tests package.json pnpm-workspace.yaml tsconfig.json vitest.config.ts eslint.config.mjs apps/**/package.json services/**/package.json packages/**/package.json",
    "typecheck": "tsc --noEmit",
    "check:implementation-loop": "tsx scripts/check-pr-implementation-loop.ts",
    "check:architecture": "tsx scripts/check-governance.ts architecture",
    "check:contracts": "tsx scripts/check-governance.ts contracts",
    "check:typesafety": "tsx scripts/check-governance.ts types",
    "check:ownership": "tsx scripts/check-ownership.ts",
    "check:docs": "tsx scripts/check-governance.ts docs",
    "check:localization": "tsx scripts/check-governance.ts localization",
    "check:secrets": "tsx scripts/check-governance.ts security",
    "check:sdl-source": "tsx scripts/check-sdl-source.ts",
    "check:dependency-vulnerabilities": "pnpm audit --audit-level=high",
    "check:security": "pnpm run check:secrets && pnpm run check:sdl-source && pnpm run check:dependency-vulnerabilities",
    "check:licenses": "pnpm licenses list --prod --json | tsx scripts/check-licenses.ts",
    "check:test-mapping": "tsx scripts/check-test-mapping.ts",
    "check:governance": "tsx scripts/check-governance.ts policy",
    "check:budgets": "tsx scripts/check-governance.ts budgets",
    "workflow:eval-claude-md": "tsx scripts/eval-claude-md.ts",
    "workflow:wow": "tsx scripts/workflow-wow.ts",
    "workflow:verify": "pnpm run validate",
    "validate": "tsx scripts/run-ci.ts",
    "build:ci": "pnpm run validate && pnpm run check:dependency-vulnerabilities"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "yaml": "^2.9.0"
  }
}
