{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Implementation Loop Evidence Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "changeId",
    "changeType",
    "changedFiles",
    "relevantFiles",
    "relevantFilesHash",
    "applicableSteps",
    "exemptedSteps",
    "implementationStartedAt",
    "stepTimestamps",
    "commands",
    "beforeArtifacts",
    "afterArtifacts",
    "focusedTest",
    "fullVerification",
    "diffAudit",
    "independentReview",
    "prProof",
    "finalReviewedDiffHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "changeId": { "type": "string", "minLength": 1 },
    "changeType": { "type": "string", "minLength": 1 },
    "changedFiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "relevantFiles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "relevantFilesHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "applicableSteps": { "type": "array", "items": { "type": "string" } },
    "exemptedSteps": {
      "type": "array",
      "items": { "type": "object", "required": ["step", "justification"] }
    },
    "implementationStartedAt": { "type": "string", "format": "date-time" },
    "stepTimestamps": { "type": "object" },
    "commands": { "type": "array", "minItems": 1 },
    "beforeArtifacts": { "type": "array" },
    "afterArtifacts": { "type": "array" },
    "focusedTest": { "type": "object" },
    "fullVerification": { "type": "object" },
    "diffAudit": { "type": "object", "required": ["path", "diffHash"] },
    "independentReview": { "type": "object", "required": ["path", "diffHash"] },
    "prProof": { "type": "object", "required": ["path", "checked", "manifestHash", "diffHash"] },
    "finalReviewedDiffHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
